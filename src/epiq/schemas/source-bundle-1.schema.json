{
  "$defs": {
    "SourceAttempt": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "maxLength": 2000,
          "title": "Query",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "blocked",
            "empty",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "detail": {
          "default": "",
          "maxLength": 2000,
          "title": "Detail",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "format": "date-time",
          "title": "Finished At",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "retry_after": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry After"
        }
      },
      "required": [
        "query",
        "status",
        "started_at",
        "finished_at"
      ],
      "title": "SourceAttempt",
      "type": "object"
    },
    "SourceDocument": {
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "requested_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Url"
        },
        "canonical_url": {
          "title": "Canonical Url",
          "type": "string"
        },
        "title": {
          "maxLength": 2000,
          "title": "Title",
          "type": "string"
        },
        "excerpt": {
          "maxLength": 200000,
          "title": "Excerpt",
          "type": "string"
        },
        "markdown": {
          "anyOf": [
            {
              "maxLength": 200000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Markdown"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "source_type": {
          "default": "web",
          "enum": [
            "web",
            "report",
            "other"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "provider": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "provider_metadata": {
          "additionalProperties": true,
          "title": "Provider Metadata",
          "type": "object"
        },
        "capture_method": {
          "default": "fetched",
          "enum": [
            "discovery",
            "fetched",
            "manual"
          ],
          "title": "Capture Method",
          "type": "string"
        }
      },
      "required": [
        "source_ref",
        "canonical_url",
        "title",
        "excerpt",
        "retrieved_at",
        "provider"
      ],
      "title": "SourceDocument",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/SourceDocument"
      },
      "maxItems": 20,
      "title": "Documents",
      "type": "array"
    },
    "attempts": {
      "items": {
        "$ref": "#/$defs/SourceAttempt"
      },
      "maxItems": 100,
      "title": "Attempts",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Warnings",
      "type": "array"
    },
    "external_job_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "External Job Id"
    },
    "usage": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ]
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "required": [
    "request_id",
    "provider"
  ],
  "title": "SourceBundle",
  "type": "object"
}
