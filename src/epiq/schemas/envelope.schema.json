{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expectedparrot.com/schemas/epiq/envelope-1.0.json",
  "title": "Epiq CLI Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "command", "argv", "data", "warnings", "errors", "next_steps"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["ok", "error"]},
    "command": {"type": "string", "minLength": 1},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "data": {},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "errors": {"type": "array", "items": {"type": "object", "required": ["code", "message"]}},
    "next_steps": {"type": "array", "items": {"$ref": "action.schema.json"}}
  }
}
