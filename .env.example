OPENAI_API_KEY=your-key-here
# Persistent Control Center planner (requires the `pi` executable).
EPIQ_PI_MODEL=openai/gpt-6.2-astra
EPIQ_PI_THINKING=high
EPIQ_RESEARCH_MODEL=gpt-5.6-terra
EPIQ_RESEARCH_CONCURRENCY=6
EPIQ_RESEARCH_QUEUE_CAPACITY=1000

# Optional split retrieval + reasoning pipeline. Leave unset for the existing backend.
# Install with: uv sync --extra web --extra sources
# EPIQ_SOURCE_PROVIDER=firecrawl
# FIRECRAWL_API_KEY=your-key-here
# EXPECTED_PARROT_API_KEY=your-key-here
# EPIQ_SOURCE_REASONING_MODEL=gpt-4o-mini
# EPIQ_SOURCE_CONCURRENCY=3
# Use EPIQ_SOURCE_PROVIDER=url for questions with explicit source URLs.
